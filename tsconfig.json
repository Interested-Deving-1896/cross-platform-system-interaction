{
    "compilerOptions": {
      /* --- Configurações do Projeto --- */
      "target": "ES2020", // Compila para uma versão moderna do JavaScript, compatível com Node.js LTS.
      "module": "commonjs", // Usa o sistema de módulos padrão do Node.js.
      "outDir": "./dist", // Diretório de saída para os arquivos JavaScript compilados.
      "rootDir": "./src", // Diretório raiz contendo os arquivos TypeScript de origem.
  
      /* --- Verificações de Tipo Estritas --- */
      "strict": true, // Habilita todas as opções de verificação de tipo estritas.
      "noImplicitAny": true, // Exige tipos explícitos quando o compilador não pode inferi-los.
      "strictNullChecks": true, // Trata `null` e `undefined` de forma mais segura.
      "forceConsistentCasingInFileNames": true, // Garante que os nomes de arquivos sejam consistentes em maiúsculas/minúsculas.
  
      /* --- Interoperabilidade de Módulos --- */
      "esModuleInterop": true, // Permite a importação de módulos CommonJS com `import from`. Essencial para pacotes como `chokidar`.
      "allowSyntheticDefaultImports": true, // Complementa o esModuleInterop.
  
      /* --- Geração de Arquivos de Declaração --- */
      "declaration": true, // Gera os arquivos de definição de tipo `.d.ts` correspondentes.
      "declarationMap": true, // Gera source maps para os arquivos de declaração, facilitando a navegação no código.
      "sourceMap": true, // Gera arquivos `.js.map` para facilitar a depuração do código TypeScript.
  
      /* --- Configurações Avançadas --- */
      "skipLibCheck": true, // Pula a verificação de tipos de todos os arquivos de declaração (`.d.ts`), acelerando a compilação.
      "resolveJsonModule": true // Permite importar arquivos .json diretamente no código.
    },
    "include": [
      "src/**/*" // Especifica que apenas os arquivos dentro do diretório `src` devem ser compilados.
    ],
    "exclude": [
      "node_modules", // Exclui o diretório de dependências.
      "dist", // Exclui o próprio diretório de saída.
      "**/*.test.ts" // Exclui os arquivos de teste da compilação final do pacote.
    ]
  }
  